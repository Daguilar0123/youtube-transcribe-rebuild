# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
# The macOS `Icon?` rule above was accidentally swallowing our app icons
# folder on case-insensitive filesystems. Explicitly keep these.
!src-tauri/icons/
!src-tauri/icons/**

# Editor
.vscode/
.idea/

# Claude Code scratch state. Worktrees are full duplicate checkouts created by
# cloud/worktree sessions (e.g. the one that produced PR #1); they are throwaway
# and should never be committed. Project-level Claude config is still trackable.
.claude/worktrees/

# Feature worktrees per the CLAUDE.md protocol (worktrees by feature, not by
# agent; kept out of .claude/ because of anthropics/claude-code#48967).
.worktrees/
